# Local demo mode starts from data/demo-data.json and requires no database service.
DATA_SOURCE="demo"
# Optional writable runtime copy; defaults to .cache/demo-data.json.
# DEMO_DATA_FILE=".cache/demo-data.json"
# Enable only behind a proxy that replaces untrusted forwarded IP headers.
TRUST_PROXY_HEADERS="false"
NEXTAUTH_SECRET="replace-with-a-random-secret-from-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
# Public demo credentials, also used by Playwright.
SEED_EMAIL="demo@taskflow.local"
SEED_PASSWORD="TaskFlowDemo123!"
SEED_NAME="Alex Morgan"
# To use PostgreSQL, set DATA_SOURCE=postgres and configure DATABASE_URL.
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/taskflow?connect_timeout=3&pool_timeout=3"
