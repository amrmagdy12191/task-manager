{
  "name": "taskflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/validate-env.ts && npm run typecheck && next dev",
    "build": "tsx scripts/validate-env.ts && prisma generate && next build",
    "start": "tsx scripts/validate-env.ts && next start",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:db": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:migrate": "tsx scripts/prisma.ts migrate dev",
    "db:deploy": "tsx scripts/prisma.ts migrate deploy",
    "db:generate": "tsx scripts/prisma.ts generate",
    "db:studio": "tsx scripts/prisma.ts studio",
    "db:seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@next/env": "^16.4.6",
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.2",
    "next": "^16.4.6",
    "next-auth": "beta",
    "prisma": "5.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0",
    "vite": "^8.3.8"
  }
}
